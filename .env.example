# =========================================================
# NiFi MCP Server - Docker 环境变量模板
# 用法: cp .env.example .env  然后按需修改
# docker compose 会自动加载项目根目录的 .env
# =========================================================

# --- MCP 服务本身 ---
# 容器内建议 streamable-http 或 sse（网络访问）；stdio 仅用于本地进程直启场景
MCP_TRANSPORT=streamable-http
# 容器内监听地址，Docker 中必须保持 0.0.0.0
MCP_HOST=0.0.0.0
# 监听端口（容器内外一致，改这里会同时改宿主机映射端口）
MCP_PORT=3030

# --- NiFi 连接（NIFI_API_BASE 与 KNOX_GATEWAY_URL 二选一，推荐前者）---
# CDP/Knox 部署典型格式: https://<host>/nifi-2-dh/cdp-proxy/nifi-app/nifi-api
# 自建部署典型格式: https://<host>:<port>/nifi-api
NIFI_API_BASE=
# KNOX_GATEWAY_URL=

# --- 认证（按优先级至少配一种）---
# Knox JWT token（CDP 推荐，以 hadoop-jwt Cookie 形式发送）
KNOX_TOKEN=
# 或完整 Cookie 字符串（优先级最高）
# KNOX_COOKIE=hadoop-jwt=eyJ...
# 或 Basic 认证自动换取 JWT（需要 token endpoint）
# KNOX_USER=
# KNOX_PASSWORD=
# KNOX_TOKEN_ENDPOINT=https://<host>/nifi-2-dh/cdp-proxy-token
# 或 Knox passcode token
# KNOX_PASSCODE_TOKEN=

# --- 自建 NiFi 认证（非 Knox/CDP 部署，例如内网 https://192.168.31.175:10443）---
# 方式一：用户名密码（推荐）—— 启动时自动登录换 JWT，token 过期自动重新登录
# NIFI_USERNAME=
# NIFI_PASSWORD=
# 方式二：手动获取的 JWT（二选一）
# NIFI_TOKEN=
# 登录端点（默认自动拼为 {NIFI_API_BASE}/access/token，一般无需设置）
# NIFI_TOKEN_ENDPOINT=

# --- 行为 ---
# true=只读（默认，安全）；false=开放全部写操作（可建流，谨慎！）
NIFI_READONLY=true
# CDP 代理上下文路径（一般无需设置）
# NIFI_PROXY_CONTEXT_PATH=

# --- TLS ---
# 自签名证书设为 false（不推荐生产），或挂载 CA 文件并用 KNOX_CA_BUNDLE
KNOX_VERIFY_SSL=true
# KNOX_CA_BUNDLE=/certs/ca-bundle.crt

# --- HTTP ---
HTTP_TIMEOUT_SECONDS=30
HTTP_MAX_RETRIES=3

# --- Docker 构建相关（仅在 docker build 时使用）---
# pip 镜像源，默认清华源（Dockerfile / compose 已内置同样默认值，此处可显式覆盖）
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
# 备选镜像源：
#   阿里云 https://mirrors.aliyun.com/pypi/simple/
#   腾讯云 https://mirrors.cloud.tencent.com/pypi/simple/
#   官方   https://pypi.org/simple
